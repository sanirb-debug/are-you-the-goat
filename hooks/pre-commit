#!/bin/sh
# Integrity gates. Installed into .git/hooks/pre-commit — to reinstall after a
# fresh clone:  cp hooks/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit
#
# WHY test-tiers.js RUNS HERE NOW: the peak-OVR tier-floor bug regressed 5-6 times
# because the suite existed but was only run when someone was deliberately working
# on tiers. Unrelated changes to award logic, OVR scaling or goatScore broke it
# silently. It is a gate, not a courtesy.
STAGED=$(git diff --cached --name-only)

if echo "$STAGED" | grep -qE '^(data\.js|game\.js|verify-costs\.js)$'; then
  echo "verify-costs: economy/data change staged — running gate..."
  node verify-costs.js || { echo "COMMIT BLOCKED: fix the cost curve (see failures above)"; exit 1; }
fi

# Tier / award / OVR logic lives in game.js and is consumed by ui.js.
if echo "$STAGED" | grep -qE '^(data\.js|game\.js|ui\.js|test-tiers\.js)$'; then
  echo "test-tiers: tier/award/OVR surface touched — running regression suite..."
  node test-tiers.js > /tmp/aytg-tiers.log 2>&1 || {
    echo "COMMIT BLOCKED: tier regression suite failed."
    grep -E "FAIL|expected" /tmp/aytg-tiers.log | head -20
    echo "  (full output: /tmp/aytg-tiers.log)"
    exit 1
  }
  grep -oE "PASSED  all [0-9]+ checks" /tmp/aytg-tiers.log || echo "test-tiers: passed"

  node test-achievements.js > /tmp/aytg-ach.log 2>&1 || {
    echo "COMMIT BLOCKED: achievement suite failed."; tail -20 /tmp/aytg-ach.log; exit 1; }
  node test-name-filter.js > /tmp/aytg-name.log 2>&1 || {
    echo "COMMIT BLOCKED: name-filter suite failed."; tail -20 /tmp/aytg-name.log; exit 1; }
  echo "test-achievements + test-name-filter: passed"
fi

# WHY test-comps.js RUNS HERE: the same comp failure was reported four times
# (Amar'e, Mourning, Towns, Yao) because each fix was verified by hand at one
# tier and the leak reopened at the next. It gates the comp dataset too — adding
# or removing a COMP_ROWS entry changes what is reachable, and removing one can
# leave an archetype with no same-level match, which is how it kept coming back.
if echo "$STAGED" | grep -qE '^(data\.js|game\.js|test-comps\.js)$'; then
  echo "test-comps: comp/tier/dataset surface touched — running regression suite..."
  node test-comps.js > /tmp/aytg-comps.log 2>&1 || {
    echo "COMMIT BLOCKED: comp regression suite failed."
    grep -E "FAIL|expected" /tmp/aytg-comps.log | head -20
    echo "  (full output: /tmp/aytg-comps.log)"
    exit 1
  }
  grep -oE "PASSED  all [0-9]+ checks" /tmp/aytg-comps.log || echo "test-comps: passed"
fi
